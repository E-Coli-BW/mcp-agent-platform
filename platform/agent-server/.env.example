# ── Agent Server Configuration ─────────────────────────────────────────
# Copy this to .env and customize. Loaded by pydantic-settings (AGENT_ prefix).
# See README.md "Configuration" section for full details.

# ── Models ─────────────────────────────────────────────────────────────
# Main agent — must support tool calling (7B+ recommended)
AGENT_DEFAULT_MODEL=qwen2.5:7b
# Global output ceiling. Agent YAML may set a lower per-agent limit.
AGENT_MAX_TOKENS=4096
# Independent runtime memory guard if a provider ignores its token limit.
AGENT_MAX_RESPONSE_CHARS=64000
# Hard deadline for each provider model call.
AGENT_LLM_TIMEOUT=60
# Auxiliary tasks — simple text→text, no tools needed (fast 0.5B works)
AGENT_CHEAP_MODEL=mlx/Qwen2.5-0.5B-Instruct-4bit
# MLX server URL (start with: ./scripts/dev/start-mlx.sh)
AGENT_MLX_BASE_URL=http://localhost:8600

# Bounded same-step retries for transient provider failures and empty responses.
AGENT_MODEL_RETRY_MAX_RETRIES=2
AGENT_MODEL_RETRY_INITIAL_DELAY_MS=500
AGENT_MODEL_RETRY_MAX_DELAY_MS=10000
AGENT_MODEL_RETRY_JITTER_RATIO=0.1
# Recommended for local development: retain run evidence across process crashes.
AGENT_RUNTIME_STORE_BACKEND=sqlite
# Private rotating log (10 MiB x 5 backups). Contains bounded request/response
# previews; treat it as sensitive local data. Set empty to disable file logging.
AGENT_LOG_FILE=.runtime/agent-server.log

# ── Features that USE cheap_model (all off by default) ─────────────────
# Without these enabled, cheap_model is never called and MLX has no effect!

# Reflexion (C1) — grades final answer, retries if quality < min_grade
#AGENT_REFLEXION_ENABLED=true
#AGENT_REFLEXION_MIN_GRADE=3

# LLM Reranking — uses cheap_model for RAG result reranking
# Options: auto | llm | cross_encoder | heuristic | none
#AGENT_RERANK_STRATEGY=llm

# Subagent verifier (C3) — grades child agent answers
#AGENT_SUBAGENT_VERIFIER_ENABLED=true

# ── Provider Keys (for cloud models) ──────────────────────────────────
#AGENT_OPENAI_API_KEY=sk-...
#AGENT_ANTHROPIC_API_KEY=sk-ant-...

# ── Infrastructure ────────────────────────────────────────────────────
# Initial workspace root. The frontend can switch it at runtime.
#AGENT_WORKSPACE=/absolute/path/to/project
# Secure default is true. Set false only for a single-user local process.
#AGENT_MULTI_TENANT_WORKSPACE=false
# Required when optional Memory/CodeExec backends are intentionally stopped.
#AGENT_STRICT_TOOLS=false
#AGENT_REDIS_URL=redis://localhost:6379/0
#AGENT_OLLAMA_BASE_URL=http://localhost:11434
#AGENT_JWT_SECRET=change-me-in-production
# Local test compatibility only. Normal browser/service tokens use RS256/JWKS.
#AGENT_ALLOW_LEGACY_HMAC_AUTH=false
