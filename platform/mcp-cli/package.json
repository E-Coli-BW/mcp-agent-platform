{
  "name": "mcp-local-tools",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test memory/__tests__/*.test.mjs && npm run test:architecture && npm run test:entrypoints",
    "test:architecture": "node architecture-contract.mjs",
    "test:entrypoints": "node entrypoint-smoke.mjs",
    "watch": "tsc --watch",
    "start:memory": "node dist/memory-server.js",
    "start:filesearch": "node dist/filesearch/filesearch-server.js"
  },
  "keywords": ["mcp", "memory", "file-search"],
  "author": "",
  "license": "ISC",
  "description": "Local MCP servers: Memory Store & File Search",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  }
}
